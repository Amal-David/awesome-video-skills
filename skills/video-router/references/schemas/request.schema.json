{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video routing request v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "agent": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "as_of": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "audio_only": {
      "type": "boolean"
    },
    "auto_duration": {
      "type": "boolean"
    },
    "available_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budget_usd": {
      "type": "number",
      "minimum": 0
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "engine": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "family": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "fps": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "host": {
      "enum": [
        "generic",
        "claude-code",
        "codex"
      ]
    },
    "input_audio_seconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Positive source-audio duration for audio-driven generation. The router also checks the task inferred from query."
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 5
    },
    "media_local_only": {
      "type": "boolean"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "query": {
      "type": "string"
    },
    "recent_only": {
      "type": "boolean"
    },
    "reference_audio": {
      "type": "integer",
      "minimum": 0
    },
    "reference_audio_seconds": {
      "type": "number",
      "minimum": 0,
      "description": "A positive duration requires a positive reference_audio count."
    },
    "reference_images": {
      "type": "integer",
      "minimum": 0
    },
    "reference_video_seconds": {
      "type": "number",
      "minimum": 0,
      "description": "A positive duration requires a positive reference_videos count."
    },
    "reference_videos": {
      "type": "integer",
      "minimum": 0
    },
    "require": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "text-to-video",
          "image-to-video",
          "reference-to-video",
          "native-audio",
          "multishot",
          "first-last-frame",
          "audio-only-reference",
          "audio-driven-video",
          "motion-transfer",
          "document-input",
          "web-input",
          "video-editing",
          "stateful-editing",
          "extend",
          "retake",
          "draft-enhance",
          "motion-graphics",
          "editable-code",
          "exact-text",
          "math-animation",
          "product-visualization",
          "sound-synthesis",
          "subtitle-timing",
          "batch-variants",
          "alpha-output",
          "quality-review",
          "local-weights",
          "lora-inference",
          "lora-training",
          "image-reference",
          "video-reference",
          "audio-reference",
          "inpainting",
          "outpainting",
          "video-restoration",
          "exr-hdr-roundtrip",
          "dubbing",
          "video-to-audio",
          "automatic-duration"
        ]
      },
      "uniqueItems": true
    },
    "resolution": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "runtime": {
      "enum": [
        "either",
        "local",
        "cloud"
      ]
    },
    "task": {
      "type": "string",
      "enum": [
        "motion",
        "generate",
        "animate-image",
        "reference",
        "transition",
        "audio-driven",
        "edit",
        "extend",
        "retake",
        "multishot",
        "hybrid",
        "math",
        "3d",
        "finishing",
        "train-lora",
        "document-to-video",
        "draft-enhance",
        "quality-review",
        "inpaint",
        "outpaint",
        "restore",
        "exr-hdr",
        "dub",
        "foley"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "media_local_only": {
            "const": true
          }
        },
        "required": [
          "media_local_only"
        ]
      },
      "then": {
        "not": {
          "properties": {
            "runtime": {
              "const": "cloud"
            }
          },
          "required": [
            "runtime"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "audio_only": {
            "const": true
          }
        },
        "required": [
          "audio_only"
        ]
      },
      "then": {
        "properties": {
          "reference_images": {
            "maximum": 0
          },
          "reference_videos": {
            "maximum": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "auto_duration": {
            "const": true
          }
        },
        "required": [
          "auto_duration"
        ]
      },
      "then": {
        "not": {
          "required": [
            "duration"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "input_audio_seconds"
        ]
      },
      "then": {
        "properties": {
          "task": {
            "const": "audio-driven"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reference_video_seconds": {
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "reference_video_seconds"
        ]
      },
      "then": {
        "required": [
          "reference_videos"
        ],
        "properties": {
          "reference_videos": {
            "minimum": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reference_audio_seconds": {
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "reference_audio_seconds"
        ]
      },
      "then": {
        "required": [
          "reference_audio"
        ],
        "properties": {
          "reference_audio": {
            "minimum": 1
          }
        }
      }
    }
  ]
}
